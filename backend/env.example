# Server Configuration
PORT=3000

# Admin Wallet Address (receives payments)
# This should be your wallet address on Base network
ADMIN_WALLET=0x0000000000000000000000000000000000000000

# Network Configuration
# Options: 'base' for mainnet, 'base-sepolia' for testnet
NETWORK=base-sepolia

# Pricing Configuration
# Price per 100 ad blocks (in USDC)
# Examples: '$0.01', '$0.001', '$0.10'
PRICE_PER_100_BLOCKS=$0.01

# Admin Key (for manual quota management)
# Generate a secure random string
ADMIN_KEY=your-secure-admin-key-here
